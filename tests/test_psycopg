import psycopg

def test_direct_connection():
    with psycopg.connect(
        host="localhost",
        port=5432,
        dbname="mydatabase",
        user="myuser",
        password="password",
    ) as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT 1")
            result = cur.fetchone()
            assert result[0] == 1